# =============================================================================
# AiBoi API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your .env file to version control.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL local. Grave a senha real somente no arquivo .env ignorado pelo Git.
DATABASE_URL=postgresql+psycopg://agrofence_app:YOUR_PASSWORD_URL_ENCODED@localhost:5432/db_agrofence

# Exclusivo do Docker Compose: substitui localhost por host.docker.internal
# dentro do container, sem duplicar ou expor a URL com senha.
DATABASE_HOST_OVERRIDE=

# Opcional: conexão direta usada somente pelo Alembic.
MIGRATION_DATABASE_URL=postgresql+psycopg://agrofence_app:YOUR_PASSWORD_URL_ENCODED@localhost:5432/db_agrofence

# O total potencial é (POOL_SIZE + MAX_OVERFLOW) x processos Uvicorn.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=agrofence-api

# Credenciais locais criadas por scripts/setup_agrofence_postgres.ps1.
# O launcher MCP usa somente AGROFENCE_READER_PASSWORD e nunca a imprime.
AGROFENCE_DB_HOST=localhost
AGROFENCE_DB_PORT=5432
AGROFENCE_DB_NAME=db_agrofence
AGROFENCE_APP_USER=agrofence_app
AGROFENCE_APP_PASSWORD=YOUR_LOCAL_APP_PASSWORD
AGROFENCE_READER_USER=codex_reader
AGROFENCE_READER_PASSWORD=YOUR_LOCAL_READER_PASSWORD

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development | production
ENV=development

# -----------------------------------------------------------------------------
# Local confirmation delivery (development only)
# -----------------------------------------------------------------------------
# mailpit: captures email and simulated SMS on this computer. Production rejects it.
# provider: uses the configured SMTP provider and requires a real PhoneSender.
AUTH_DELIVERY_MODE=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_FROM_EMAIL=no-reply@agrofence.local

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# REQUIRED in production: generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Application will refuse to start if missing in production.
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# REQUIRED in production — wildcard (*) is NOT allowed in production.
# Comma-separated list of allowed origins.
# Example: CORS_ALLOWED_ORIGINS=https://app.aiboi.com.br,https://admin.aiboi.com.br
#
# Development default (if not set): localhost:3000, localhost:8080, localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Redis — Rate Limiting (required in production)
# -----------------------------------------------------------------------------
# ENV=production requires a reachable Redis instance. Dev/test may use in-memory fallback.
# Example: REDIS_URL=redis://localhost:6379
# Supabase: REDIS_URL=redis://default:password@host.upstash.io:6379
REDIS_URL=

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# Required in production for: email verification codes, password reset links.
# If not configured in development, only a masked delivery warning is logged;
# the code/token itself is never logged or returned by the API.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=api@example.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_EMAIL=noreply@aiboi.com
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Email (Resend — alternative to SMTP)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@aiboi.com

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Used to generate password reset links in emails.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# REQUIRED to enable Google Sign-In. Get from Google Cloud Console.
# Application will return HTTP 500 if Google login is attempted without this.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
